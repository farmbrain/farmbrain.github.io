@inproceedings{smec-nsdi26,
  abbr      = {NSDI},
  author    = {Xiao Zhang and Daehyeok Kim},
  title     = {Enabling SLO-Aware 5G Multi-Access Edge Computing with SMEC},
  booktitle = {Proceedings of the 23rd USENIX Symposium on Networked Systems Design and Implementation (NSDI)},
  abstract  = {5G multi-access edge computing (MEC) promises to enable latency-critical applications by bringing computational power closer to mobile devices. Our measurements on commercial MEC deployments reveal frequent SLO violations due to high tail latencies. We identify resource contention at the RAN and the edge server as the root cause, compounded by SLO-unaware schedulers. Existing SLO-aware MEC schedulers require RAN--edge coordination, making them impractical for deployment and prone to poor performance due to coordination delays, limited heterogeneous application support, and ignoring edge resource contention. This paper introduces SMEC, a practical, SLO-aware resource management framework that facilitates deadline-aware scheduling through fully decoupled operations at the RAN and edge servers. Our key insight is that standard 5G protocols and application behaviors naturally provide information exploitable for SLO-aware management without extensive infrastructure or application changes. Evaluation on our 5G testbed shows that SMEC achieves 90--96\% SLO satisfaction versus under 6\% for existing approaches, while reducing tail latency by up to 122x.},
  pdf       = {https://daehyeok.kim/assets/papers/smec-nsdi26.pdf},
  slides    = {https://daehyeok.kim/assets/talks/smec-nsdi26-slides.pdf},
  code      = {https://github.com/smec-project},
  website   = {https://smec-project.github.io},
  month     = may,
  year      = 2026
}
